# Play Aura Environment Variables
# Copy this file to .env and fill in your real project keys.
# NEVER put your Supabase service_role key or secret keys in VITE_* variables!

# Supabase Public Project Credentials (safe for browser use with RLS enabled)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Google AdSense (Optional — leave blank until your AdSense account is approved)
VITE_ADSENSE_CLIENT_ID=""
VITE_ADSENSE_HOME_SLOT=""
VITE_ADSENSE_PLAYER_SLOT=""
